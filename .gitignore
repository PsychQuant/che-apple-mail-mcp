# Swift
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# IDE
.vscode/
*.xcodeproj/
*.xcworkspace/

# MCPB package (generated, rebuild via scripts/build-mcpb.sh)
mcpb/*.mcpb
mcpb/*.mcpb.sha256

# Private docs (not for public repo)
docs/private/

# Build artifacts (distributed via GitHub Release)
mcpb/server/*
!mcpb/server/.gitkeep
.spectra/
openspec/.vector-search.db*

# Local/personal files
.remember/
.agents/
# .claude/ is local-only EXCEPT .claude/rules/ (shared agent-authoring rules — must
# reach remote so every clone/machine inherits them, e.g. compose-wrapper-free cite-block).
# git can't re-include a path whose parent dir is excluded, so ignore .claude/*'s
# entries individually and carve the rules dir back in.
.claude/*
!.claude/rules/
logs/

# MCP Registry tokens
.mcpregistry_*
*.code-workspace

# Stray CLI/tool logs (e.g. Codex error.log) — never track
*.log

# IDD tree-lock (idd-tree-lock.sh #183) — per-machine session state, not tracked
.claude/.idd/tree-lock
