{
  "manifest_version": "0.3",
  "name": "che-apple-mail-mcp",
  "display_name": "Apple Mail Manager",
  "version": "2.27.0",
  "description": "Apple Mail MCP server with 53 tools — SQLite-powered millisecond search across 250K+ emails",
  "long_description": "The most comprehensive Apple Mail MCP server providing 53 tools. v2.0 adds a SQLite search engine that queries Mail.app's Envelope Index directly for millisecond-speed search across all accounts (subject, sender, recipient, date range). Also includes .emlx file parser for direct email content reading, and batch operations (get_emails_batch, list_attachments_batch). Falls back to AppleScript when SQLite is unavailable. Requires macOS 13.0+ and Full Disk Access for SQLite features.",
  "author": {
    "name": "Che Cheng",
    "url": "https://github.com/kiki830621"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kiki830621/che-apple-mail-mcp.git"
  },
  "homepage": "https://github.com/kiki830621/che-apple-mail-mcp",
  "support": "https://github.com/kiki830621/che-apple-mail-mcp/issues",
  "icon": "icon.png",
  "keywords": [
    "apple-mail",
    "email",
    "mail",
    "macos",
    "applescript",
    "productivity"
  ],
  "license": "MIT",
  "privacy_policies": [
    "https://github.com/kiki830621/che-apple-mail-mcp/blob/main/mcpb/PRIVACY.md"
  ],
  "server": {
    "type": "binary",
    "entry_point": "server/CheAppleMailMCP",
    "mcp_config": {
      "command": "${__dirname}/server/CheAppleMailMCP",
      "args": [],
      "env": {}
    }
  },
  "tools": [
    {
      "name": "batch_export_emails_markdown",
      "description": "batch_export_emails_markdown"
    },
    {
      "name": "check_accessibility",
      "description": "Check whether Accessibility (GUI-scripting) is granted via AXIsProcessTrusted(). Required for the #175 wrapper-free compose path (compose_email / create_draft use mailto + keystrokes so the body is…"
    },
    {
      "name": "check_automation",
      "description": "Check whether Automation (Apple Events to Mail) is granted TO THIS BINARY — the third TCC axis after check_fda and check_accessibility (#293). Non-prompting probe (AEDeterminePermissionToAutomateTa…"
    },
    {
      "name": "check_fda",
      "description": "Check whether Full Disk Access is granted (functionally probes the Apple Mail Envelope Index). Returns status plus the exact steps to grant it if not. Use when SQLite-only features (search_emails p…"
    },
    {
      "name": "check_for_new_mail",
      "description": "Check for new mail"
    },
    {
      "name": "compose_email",
      "description": "Send new email"
    },
    {
      "name": "copy_email",
      "description": "Copy to another mailbox"
    },
    {
      "name": "create_draft",
      "description": "Create a draft"
    },
    {
      "name": "create_mailbox",
      "description": "Create a new mailbox"
    },
    {
      "name": "create_rule",
      "description": "Create a new rule"
    },
    {
      "name": "delete_email",
      "description": "Delete email (to trash)"
    },
    {
      "name": "delete_mailbox",
      "description": "Delete a mailbox"
    },
    {
      "name": "delete_rule",
      "description": "Delete a rule"
    },
    {
      "name": "enable_rule",
      "description": "Enable/disable a rule"
    },
    {
      "name": "export_emails_markdown",
      "description": "DEPRECATED — renamed to batch_export_emails_markdown; this alias will not be removed before the next major release (v3.0)."
    },
    {
      "name": "extract_address",
      "description": "Extract email from full address"
    },
    {
      "name": "extract_name_from_address",
      "description": "Extract name from email address"
    },
