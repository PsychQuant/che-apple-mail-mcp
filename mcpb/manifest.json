    },
    {
      "name": "set_flag_color",
      "description": "Set flag color (7 colors)"
    },
    {
      "name": "synchronize_account",
      "description": "Sync IMAP account"
    },
    {
      "name": "update_draft",
      "description": "Replace an existing draft (upsert): locate it by draft_id (from list_drafts) or an EXACT subject_match, create the replacement via the same mechanism and eligibility rules as create_draft, then del…"
    }
  ],
  "compatibility": {
    "platforms": [
      "darwin"
    ]
  }
}
